# direnv configuration for hcp-casdoor
# Sets up Go paths and installs dependencies on first enter
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"
export PATH="$GOBIN:$PATH"

# Fetch Go modules (best-effort)
if command -v go >/dev/null 2>&1 && [ -f go.mod ]; then
  go mod download || true
fi

# Install web dependencies only if yarn is available and node_modules missing
if command -v yarn >/dev/null 2>&1 && [ ! -d web/node_modules ]; then
  (cd web && yarn install --frozen-lockfile --network-timeout 1000000) || true
fi

# You may run `direnv allow` to authorize this file (this is done automatically by the workflow below)
